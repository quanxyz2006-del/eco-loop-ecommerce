# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=sqlite:///../database/eco_loop.db
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://127.0.0.1:8000"]

# Optional first-admin bootstrap. Set both only on a trusted deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPERADMIN_EMAIL=admin@example.com

# Gemini chatbot (optional; FAQ fallback works without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gmail SMTP verification. Use a newly generated App Password locally.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_SSL=false
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_FROM_NAME=ECO-LOOP Verification
